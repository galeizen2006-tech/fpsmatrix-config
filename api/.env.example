# ---------------------------------------------------------------
# FPSMatrix Config API - variables de entorno (EJEMPLO)
# Copiá este archivo a ".env" y completá los valores.
# NUNCA subas el archivo .env a GitHub. Estos son placeholders.
# ---------------------------------------------------------------

# Repositorio de GitHub donde vive config.json (tenés que crearlo vos).
# Formato: usuario-u-organizacion/nombre-del-repo
GITHUB_REPO=galeizen2006-tech/fpsmatrix-config
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=config.json

# Token SOLO si el repositorio es PRIVADO. Lleva el prefijo FPSMATRIX_ a propósito:
# así nunca se usa por error un GITHUB_TOKEN genérico que ya exista en la máquina. Dejalo vacío para un repo público.
# Va únicamente en el servidor (este backend), jamás en el programa FPSMatrix.
# Usá un "fine-grained token" con permiso de solo lectura "Contents: Read-only"
# limitado a ese único repositorio.
FPSMATRIX_GITHUB_TOKEN=

# Cada cuántos segundos se busca una configuración nueva (mínimo 30).
REFRESH_INTERVAL_SECONDS=300

# Tiempo máximo de cada pedido a GitHub, en segundos.
HTTP_TIMEOUT_SECONDS=10

# Carpeta donde se guarda la última configuración válida (modo sin Internet).
CACHE_DIR=./cache

# Clave para los endpoints privados /admin/*. Vacía = endpoints privados apagados.
# Generá una larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Dominios permitidos para las URLs que aparezcan dentro de config.json
# (descargas, banners). Separados por coma.
ALLOWED_URL_HOSTS=github.com,raw.githubusercontent.com,fpsmatrix.com,www.fpsmatrix.com

# Orígenes permitidos para CORS (vacío = ninguno; la app de escritorio no lo necesita).
CORS_ORIGINS=
